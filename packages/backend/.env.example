# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Database Configuration (SQLite)
# Path to the SQLite file. Defaults to ./nommable.db in dev, /data/nommable.db in Docker.
DB_PATH=./nommable.db

# Auth Configuration (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars

# Admin Account Configuration
# Only used when SEED_ADMIN_ON_BOOT=true (admin seeded from these on boot).
# Otherwise (the default), the admin account is created via the first-run
# onboarding wizard at /setup and these are ignored.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# AI Provider API Keys (Optional - users can configure per-account)
# These are fallback/default keys if not configured per-user
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GOOGLE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS
CORS_ORIGIN=http://localhost:5173

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Email / SMTP Configuration (Optional - for sending user invitations via email)
# If left blank, invitations will generate direct registration links for manual sharing
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@nommable.local
