# Nommable environment configuration (single-container, SQLite)
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.

# --- Database (SQLite) ---
# Path to the SQLite file. In Docker, /data is the persistent volume.
DB_PATH=/data/nommable.db

# --- Auth (Better Auth) ---
# Generate: openssl rand -hex 32   (min 32 chars; longer is better)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
ADMIN_USERNAME=admin
# Initial admin password — only used when SEED_ADMIN_ON_BOOT=true (admin seeded
# from these on boot). Otherwise the admin is created via the onboarding wizard.
ADMIN_PASSWORD=change-me

# --- AI API key encryption (protects provider keys stored in the DB) ---
# MUST be exactly 64 hex characters (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-64-hex-characters-00000000000000000000000000000000

# --- App ---
CORS_ORIGIN=http://localhost:8992
# Optional: provider keys can also be set globally via env (per-user DB config takes precedence)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Uploads ---
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE=5242880

# --- SMTP (optional — for invitation emails; also configurable in Admin Settings) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@nommable.local
